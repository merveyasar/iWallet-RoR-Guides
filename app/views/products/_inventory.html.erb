<% if product.inventory_count.positive? %>
  <div class="inline-flex items-center gap-2 bg-[#f5f5f7] border border-[#d2d2d7] px-4 py-2 rounded-full text-xs font-medium text-[#1d1d1f]">
    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
    <span><%= product.inventory_count %> units available in store</span>
  </div>
<% else %>
  <div class="space-y-4 bg-white border border-[#d2d2d7] p-6 rounded-3xl shadow-sm">
    <div class="space-y-1">
      <div class="flex items-center gap-2 text-xs font-semibold text-[#bf4800] uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-[#bf4800]"></span>
        <span>Out of Stock</span>
      </div>
      <p class="text-sm text-[#1d1d1f] font-medium">Email me when available.</p>
      <p class="text-xs text-[#86868b]">Leave your credentials below to receive an automated notification dispatch.</p>
    </div>

    <%= form_with model: [product, Subscriber.new], class: "flex flex-col sm:flex-row gap-2 pt-2" do |form| %>
      <div class="w-full">
        <%= form.email_field :email, 
            placeholder: "you@example.com", 
            required: true, 
            class: "w-full bg-white border border-[#d2d2d7] rounded-xl px-4 py-2.5 text-xs text-[#1d1d1f] placeholder-[#86868b] focus:outline-none focus:border-[#0071e3] focus:ring-1 focus:ring-[#0071e3] transition duration-200" %>
      </div>
      <%= form.submit "Notify Me", 
          class: "bg-[#0071e3] text-white text-xs font-medium px-5 py-2.5 rounded-xl hover:bg-[#0077ed] active:bg-[#0062c3] transition duration-200 cursor-pointer shadow-sm shrink-0" %>
    <% end %>
  </div>
<% end %>