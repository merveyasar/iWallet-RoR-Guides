<% content_for :title, "Store — Selected Collection" %>

<div class="space-y-12">
  
  <div class="space-y-4 border-b border-[#d2d2d7] pb-8 flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div class="space-y-1">
      <h1 class="text-4xl font-semibold tracking-tight text-[#1d1d1f]">
        Store. <span class="text-[#86868b]">The best way to buy the products you love.</span>
      </h1>
      <p class="text-xs font-mono text-[#86868b] tracking-wider mt-1">
        System Message: <%= t "hello" %>
      </p>
    </div>

    <div class="flex items-center gap-4 shrink-0">
      <% if authenticated? %>
        <%= link_to "Add Product", new_product_path, class: "bg-[#0071e3] text-white text-xs font-normal px-4 py-2 rounded-full hover:bg-[#0077ed] transition inline-block text-center" %>
      <% else %>
        <%= link_to "Admin Login", new_session_path, class: "text-xs font-medium text-[#0071e3] hover:underline" %>
      <% end %>
    </div>
  </div>
  <div class="max-w-md my-6">
    <%= form_with url: products_path, method: :get, local: true, class: "relative flex items-center" do |form| %>
      <%= form.text_field :q, 
          value: params[:q], 
          placeholder: "Search archive specs...", 
          class: "w-full bg-[#f5f5f7] border border-[#d2d2d7] rounded-full pl-11 pr-4 py-2.5 text-xs text-[#1d1d1f] placeholder-[#86868b] focus:outline-none focus:bg-white focus:border-[#0071e3] focus:ring-1 focus:ring-[#0071e3] transition duration-200" %>
      
      <div class="absolute left-4 pointer-events-none text-[#86868b] text-sm">
        🔍
      </div>

      <% if params[:q].present? %>
        <%= link_to "Clear", products_path, class: "absolute right-4 text-[10px] font-medium text-[#0071e3] hover:underline" %>
      <% end %>
    <% end %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
    <% @products.each do |product| %>
      <% cache product do %>
        
        <%= link_to product, class: "bg-white border border-[#d2d2d7] rounded-3xl p-6 flex flex-col justify-between min-h-[340px] hover:shadow-md transition duration-200 group" do %>
          
          <div class="space-y-1">
            <h2 class="text-lg font-semibold text-[#1d1d1f] leading-tight group-hover:text-[#0071e3] transition">
              <%= product.name %>
            </h2>
            <p class="text-xs text-[#86868b]">
              <%= product.inventory_count.positive? ? "#{product.inventory_count} units" : "Out of stock" %>
            </p>
          </div>

          <div class="my-4 h-32 w-full flex items-center justify-center rounded-2xl bg-[#f5f5f7] border border-[#e8e8ed] overflow-hidden">
            <% if product.featured_image.attached? %>
              <%= image_tag product.featured_image, class: "max-h-full max-w-full object-contain mix-blend-multiply" %>
            <% else %>
              <span class="text-[11px] text-[#86868b] font-light italic">No image</span>
            <% end %>
          </div>

          <div class="flex items-center justify-between pt-2 border-t border-[#f5f5f7] text-xs">
            <span class="font-mono text-[#86868b] text-[10px]">#00<%= product.id %></span>
            <span class="text-[#0071e3] font-medium group-hover:underline">Explore ›</span>
          </div>

        <% end %>

      <% end %>
    <% end %>
  </div>

</div>