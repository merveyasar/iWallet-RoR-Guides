<% content_for :title, "Edit #{@product.name} — Admin" %>

<div class="max-w-2xl mx-auto py-8 space-y-8">
  
  <div class="space-y-2 border-b border-[#d2d2d7] pb-4">
    <%= link_to @product, class: "text-xs font-medium text-[#0071e3] hover:underline flex items-center gap-0.5 group inline-flex" do %>
      <span class="text-sm transition-transform group-hover:-translate-x-0.5">‹</span> Cancel and view product
    <% end %>
    
    <div class="space-y-1">
      <h1 class="text-3xl font-semibold tracking-tight text-[#1d1d1f]">Edit Product Spec</h1>
      <p class="text-xs text-[#86868b]">Update the global archive parameters for <%= @product.name %>.</p>
    </div>
  </div>

  <div class="bg-white border border-[#d2d2d7] rounded-3xl p-8 shadow-sm">
    <%= render "form", product: @product %>
  </div>

</div>