<% content_for :title, "Sign In" %>

<div class="min-h-[55vh] flex flex-col items-center justify-center">
  <div class="w-full max-w-[380px] bg-white border border-[#d2d2d7] p-8 rounded-3xl shadow-sm space-y-6">
    
    <div class="text-center space-y-2">
      <div class="w-10 h-10 rounded-full bg-[#1d1d1f] text-white flex items-center justify-center mx-auto font-bold text-lg select-none">
        
      </div>
      <h2 class="text-2xl font-semibold tracking-tight text-[#1d1d1f]">Sign in to Store</h2>
      <p class="text-xs text-[#86868b] tracking-normal">Please verify your administrator credentials.</p>
    </div>

    <%= form_with url: session_path, class: "space-y-4" do |form| %>
      
      <div class="space-y-1">
        <%= form.email_field :email_address, 
            required: true, 
            autofocus: true, 
            autocomplete: "username", 
            placeholder: "Email", 
            value: params[:email_address],
            class: "w-full bg-white border border-[#d2d2d7] rounded-xl px-4 py-3 text-sm text-[#1d1d1f] placeholder-[#86868b] focus:outline-none focus:border-[#0071e3] focus:ring-1 focus:ring-[#0071e3] transition duration-200" %>
      </div>

      <div class="space-y-1">
        <%= form.password_field :password, 
            required: true, 
            placeholder: "Password", 
            autocomplete: "current-password", 
            maxlength: 72,
            class: "w-full bg-white border border-[#d2d2d7] rounded-xl px-4 py-3 text-sm text-[#1d1d1f] placeholder-[#86868b] focus:outline-none focus:border-[#0071e3] focus:ring-1 focus:ring-[#0071e3] transition duration-200" %>
      </div>

      <div class="pt-2">
        <%= form.submit "Sign In", 
            class: "w-full bg-[#0071e3] text-white text-sm font-medium py-3 rounded-xl hover:bg-[#0077ed] active:bg-[#0062c3] transition-colors duration-200 cursor-pointer shadow-sm text-center" %>
      </div>

    <% end %>

    <div class="text-center pt-2 border-t border-[#f5f5f7]">
      <%= link_to "Forgot password?", new_password_path, class: "text-xs text-[#0071e3] hover:underline transition duration-150" %>
    </div>

  </div>
</div>