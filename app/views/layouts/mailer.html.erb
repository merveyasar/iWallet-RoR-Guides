<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      /* Email clients need primitive inline styles */
      body {
        background-color: #0c0a09;
        color: #e7e5e4;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 40px 20px;
        -webkit-text-size-adjust: none;
      }
      .container {
        max-width: 560px;
        margin: 0 auto;
        background-color: #1c1917;
        border: 1px solid #2e2a24;
        border-radius: 8px;
        padding: 32px;
      }
      a {
        color: #fbbf24;
        text-decoration: none;
        border-bottom: 1px dashed #fbbf24;
      }
      .footer {
        margin-top: 32px;
        text-align: center;
        font-size: 11px;
        color: #57534e;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <%= yield %>
    </div>
    <div class="footer">
      Sent from Studio Store Dispatcher
    </div>
  </body>
</html>