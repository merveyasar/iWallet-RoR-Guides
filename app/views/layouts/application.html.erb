<!DOCTYPE html>
<html class="h-full bg-[#f5f5f7] text-[#1d1d1f]">
  <head>
    <title><%= content_for(:title) || "Store" %></title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
    </style>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full antialiased flex flex-col justify-between bg-[#f5f5f7]">
    
    <header class="bg-[#f5f5f7]/80 backdrop-blur-md sticky top-0 z-50 border-b border-[#d2d2d7]">
      <nav class="mx-auto max-w-5xl h-12 px-6 flex items-center justify-between text-xs font-normal tracking-tight text-[#1d1d1f]/80">
        <%= link_to "Store", root_path, class: "hover:text-black transition font-semibold text-sm" %>
        
        <div class="flex items-center gap-6">
          <% if authenticated? %>
            <%= button_to "Log out", session_path, method: :delete, class: "hover:text-black transition bg-transparent border-none p-0 cursor-pointer text-xs" %>
          <% else %>
            <%= link_to "Sign In", new_session_path, class: "hover:text-black transition" %>
          <% end %>
        </div>
      </nav>
    </header>

    <div class="max-w-4xl mx-auto w-full px-6 mt-4">
      <% if flash[:notice].present? %>
        <div class="p-4 mb-4 bg-white border border-[#d2d2d7] text-[#1d1d1f] text-sm rounded-2xl shadow-sm flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-[#0071e3] shrink-0 block"></span>
          <p class="font-normal tracking-tight"><%= flash[:notice] %></p>
        </div>
      <% end %>

      <% if flash[:alert].present? %>
        <div class="p-4 mb-4 bg-white border border-rose-300 text-rose-600 text-sm rounded-2xl shadow-sm flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-rose-500 shrink-0 block"></span>
          <p class="font-medium tracking-tight"><%= flash[:alert] %></p>
        </div>
      <% end %>
    </div>

    <main class="mb-auto mx-auto max-w-5xl w-full px-6 py-12">
      <%= yield %>
    </main>

    <footer class="max-w-5xl mx-auto w-full px-6 py-8 border-t border-[#d2d2d7] text-[11px] text-[#86868b]">
      <p>Copyright © <%= Time.current.year %> Studio Store Archive. All rights reserved.</p>
    </footer>

  </body>
</html>